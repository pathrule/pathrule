          {
            "type": "command",
            "name": "pathrule",
            "command": "node \"${extensionPath}${/}scripts${/}pathrule-launch\" hook --mcp=bundled",
            "timeout": 30000
          }
        ]
      }
    ],
    "AfterTool": [
      {
