{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "pathrule",
            "command": "node \"${extensionPath}${/}scripts${/}pathrule-launch\" hook --mcp=bundled",
            "timeout": 30000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "pathrule",
            "command": "node \"${extensionPath}${/}scripts${/}pathrule-launch\" hook --mcp=bundled",
            "timeout": 30000
          }
        ]
      }
    ],
    "BeforeTool": [
