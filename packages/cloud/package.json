{
  "name": "@pathrule/cloud",
  "version": "1.0.6",
  "description": "The open client of Pathrule Cloud: sign-in, organizations and attached folders, the MCP server and the hook over a Pathrule Cloud workspace, delivery reports and the CLI telemetry. The Pathrule Cloud service itself is proprietary and not part of this package.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/pathrule/pathrule/tree/main/packages/cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathrule/pathrule.git",
    "directory": "packages/cloud"
  },
  "bugs": {
    "url": "https://github.com/pathrule/pathrule/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pathrule/cli": "workspace:*",
    "@pathrule/core": "workspace:*",
    "@pathrule/host": "workspace:*",
    "@pathrule/integrations": "workspace:*",
    "@pathrule/mcp": "workspace:*",
    "@types/node": "^25.6.0",
    "typescript": "^5.7.2",
    "vitest": "^2",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@pathrule/agent-ir": "workspace:*",
    "@pathrule/protocol": "workspace:*"
  }
}
