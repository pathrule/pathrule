{
  "name": "@pathrule/cli",
  "version": "1.0.1",
  "description": "Pathrule, the context layer for AI coding agents: path-scoped memories, rules, and skills for Claude Code, Cursor, Codex, and Windsurf.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathrule/pathrule.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/pathrule/pathrule/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/pathrule/pathrule/issues"
  },
  "type": "module",
  "bin": {
    "pathrule": "./dist/index.js"
  },
  "exports": {
    "./*.js": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-npm-package.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@pathrule/cloud": "workspace:*",
    "@pathrule/core": "workspace:*",
    "@pathrule/host": "workspace:*",
    "@pathrule/integrations": "workspace:*",
    "@pathrule/mcp": "workspace:*",
    "@pathrule/protocol": "workspace:*",
    "better-sqlite3": "^13"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2"
  }
}
