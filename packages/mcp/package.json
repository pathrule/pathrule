{
  "name": "@pathrule/mcp",
  "version": "1.0.3",
  "description": "Pathrule's local MCP server: the knowledge tools over the local store, and the plugin seam an account edition and host-bridged tools plug into.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathrule/pathrule.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/pathrule/pathrule/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/pathrule/pathrule/issues"
  },
  "type": "module",
  "exports": {
    "./*.js": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-npm-package.mjs",
    "build:bin": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist-bin/index.js",
    "harness": "tsx scripts/dev-harness.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pathrule/agent-ir": "workspace:*",
    "@pathrule/protocol": "workspace:*",
    "better-sqlite3": "^13",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@pathrule/core": "workspace:*",
    "@pathrule/host": "workspace:*",
    "@pathrule/integrations": "workspace:*"
  },
  "devDependencies": {
    "@pathrule/core": "workspace:*",
    "@pathrule/host": "workspace:*",
    "@pathrule/integrations": "workspace:*",
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2"
  }
}
